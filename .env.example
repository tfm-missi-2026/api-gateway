# --- api-gateway standalone ---
# Puerto host del gateway (el contenedor escucha en 8080)
GATEWAY_PORT=8080

# URL del registro de Eureka donde se descubre a los microservicios
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# Clave secreta compartida con los microservicios para validar el JWT (HS256).
# En entornos reales sustituir por un par de claves RS256 publicadas via JWKS.
JWT_SECRET=cambiar-esta-clave-en-produccion-minimo-32-bytes-aleatorios
